@page
@model Clinical.Pages.ErrorModel
@{
    ViewData["Title"] = "Error - CTTMS";
}

<section class="py-5 text-center">
    <div class="container">
        <div class="card border-0 shadow-sm p-5 rounded-4 mx-auto" style="max-width: 600px;">
            <div class="mb-4">
                <i class="bi bi-exclamation-triangle-fill text-warning display-1"></i>
            </div>
            <h1 class="fw-bold text-danger">Oops! Something went wrong.</h1>
            <p class="text-muted mt-3">
                An unexpected error occurred while processing your request. Please try again later or contact your system administrator.
            </p>

            @if (Model.ShowRequestId)
            {
                <p class="text-secondary small mt-2">
                    <strong>Request ID:</strong> <code>@Model.RequestId</code>
                </p>
            }

            <div class="mt-4">
                <a href="/" class="btn btn-outline-primary px-4">
                    <i class="bi bi-arrow-left"></i> Return to Home
                </a>
            </div>
        </div>
    </div>
</section>
