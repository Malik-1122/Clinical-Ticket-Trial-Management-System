@page "{id:int}"
@model Clinical.Pages.Admin.DeleteTicketModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Delete Ticket";
}

<div class="card shadow-lg mx-auto mt-5" style="max-width: 700px;">
    <div class="card-body text-center">
        <h3 class="text-danger fw-bold mb-4">Delete Ticket</h3>

        <p class="mb-3">Are you sure you want to delete this ticket?</p>
        <h5 class="fw-semibold text-primary mb-3">@Model.Ticket.Title</h5>

        <form method="post">
            <input type="hidden" asp-for="Ticket.TicketID" />
            <button type="submit" class="btn btn-danger px-4">Delete</button>
            <a asp-page="/Admin/ViewTickets" class="btn btn-secondary px-3 ms-2">Cancel</a>
        </form>
    </div>
</div>
