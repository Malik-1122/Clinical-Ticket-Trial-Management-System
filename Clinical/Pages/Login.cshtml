@page
@model Clinical.Pages.LoginModel
@{
    ViewData["Title"] = "Login";
}

<!-- Background -->
<div class="min-vh-100 d-flex align-items-center justify-content-center" style="background: linear-gradient(135deg, #e3f2fd, #ffffff);">

    <div class="col-md-5">
        <div class="card shadow-lg border-0 rounded-4">
            <div class="card-body p-4">

                <!-- Title -->
                <h3 class="text-center text-primary fw-bold mb-4">Login to CTTMS</h3>

                <!-- ✅ Registration Success -->
                @if (Model.Registered)
                {
                    <div class="alert alert-success text-center">
                        Registration successful! Please log in.
                    </div>
                }

                <!-- ✅ Invalid credentials -->
                @if (!ViewData.ModelState.IsValid)
                {
                    foreach (var modelError in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div class="alert alert-danger text-center">@modelError.ErrorMessage</div>
                    }
                }

                <!-- ✅ Login Form -->
                <form method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <!-- Email -->
                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label fw-semibold">Email address</label>
                        <input asp-for="Input.Email" type="email" class="form-control form-control-lg rounded-3" placeholder="Enter your email" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <!-- Password -->
                    <div class="mb-4">
                        <label asp-for="Input.Password" class="form-label fw-semibold">Password</label>
                        <input asp-for="Input.Password" type="password" class="form-control form-control-lg rounded-3" placeholder="Enter your password" />
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>

                    <!-- Submit Button -->
                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-primary btn-lg rounded-pill shadow-sm">
                            <i class="bi bi-box-arrow-in-right me-2"></i> Sign In
                        </button>
                    </div>

                    <!-- Optional: Register link -->
                    <p class="text-center text-muted small">
                        Don’t have an account?
                        <a asp-page="/Register" class="text-primary fw-semibold text-decoration-none">Register here</a>
                    </p>
                </form>
            </div>
        </div>

        <!-- Footer -->
        <div class="text-center text-muted small mt-4">
            © 2025 - Clinical Trial Ticket Management System
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
