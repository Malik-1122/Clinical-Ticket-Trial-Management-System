@page
@model Clinical.Pages.PrivacyModel
@{
    ViewData["Title"] = "Privacy Policy - CTTMS";
}

<section class="py-5">
    <div class="container">
        <div class="text-center mb-4">
            <h1 class="display-6 fw-bold text-primary">Privacy Policy</h1>
            <p class="text-muted">Clinical Trial Ticket Management System (CTTMS)</p>
        </div>

        <div class="card shadow-sm border-0 rounded-4 p-4">
            <h5 class="fw-semibold mb-3">Your Data and Privacy</h5>
            <p>
                The Clinical Trial Ticket Management System respects your privacy and is committed to protecting any personal information
                that you provide. Information such as your name, role, and email address is collected solely for system authentication,
                ticket management, and notifications.
            </p>

            <h5 class="fw-semibold mt-4 mb-3">Data Usage</h5>
            <ul>
                <li>User details are used to allocate, resolve, and review clinical trial tickets.</li>
                <li>All actions are logged in the Audit Log for transparency and compliance.</li>
                <li>No user credentials or personal information are shared externally.</li>
            </ul>

            <h5 class="fw-semibold mt-4 mb-3">Security Commitment</h5>
            <p>
                CTTMS employs secure authentication and role-based access to ensure sensitive data is available only to authorized users.
                Regular audits are conducted to ensure compliance with clinical data regulations.
            </p>

            <p class="mt-4 text-muted small">
                If you have questions regarding data privacy or system access, please contact the system administrator.
            </p>
        </div>

        <div class="text-center mt-5">
            <a href="/" class="btn btn-primary px-4">Back to Home</a>
        </div>
    </div>
</section>
