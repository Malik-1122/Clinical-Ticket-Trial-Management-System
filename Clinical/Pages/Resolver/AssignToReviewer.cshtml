@page "{id:int}"
@model Clinical.Pages.Resolver.AssignToReviewerModel
@{
    Layout = "_ResolverLayout";   
    ViewData["Title"] = "Assign Ticket to Reviewer";
}

<div class="container mt-4">
    <h3 class="text-primary mb-4">Assign Ticket #@Model.TicketID to Reviewer</h3>

    <form method="post">
        <div class="mb-3">
            <label class="form-label fw-bold">Select Reviewer</label>
            
            <select class="form-select" name="ReviewerID" required>
                <option value="">-- Select Reviewer --</option>

                @foreach (var r in Model.Reviewers)
                {
                    <option value="@r.UserID">@r.Name</option>   <!-- ONLY NAME -->
                }
            </select>
        </div>

        <button type="submit" class="btn btn-success">Assign</button>
        <a asp-page="/Resolver/MyTickets" class="btn btn-secondary ms-2">Cancel</a>
    </form>
</div>
